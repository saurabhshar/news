<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Germany Daily &mdash; {{ date }}</title>
  <style>
    /* ─── Fonts ─── */
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Source+Serif+4:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Source+Sans+3:wght@300;400;600;700&display=swap');

    /* ─── Variables ─── */
    :root {
      --ink:       #1c1c1c;
      --ink-soft:  #3d3d3d;
      --ink-faint: #767676;
      --paper:     #faf7f2;
      --paper-warm:#f2ede4;
      --gold:      #b8860b;
      --gold-light:#d4a843;
      --rule:      #1c1c1c;
      --rule-thin: #c8bfa8;
      --red-flag:  #9b1c1c;
    }

    /* ─── Reset ─── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--paper);
      color: var(--ink);
      font-family: 'Source Serif 4', Georgia, serif;
      font-size: 16px;
      line-height: 1.65;
    }
    a { color: inherit; text-decoration: none; }
    a:hover { color: var(--gold); }

    /* ─── Top ribbon ─── */
    .top-ribbon {
      background: var(--ink);
      color: #aaa;
      font-family: 'Source Sans 3', Arial, sans-serif;
      font-size: 0.7rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      display: flex;
      justify-content: space-between;
      padding: 0.45rem 2rem;
    }
    .top-ribbon span { color: #ccc; }

    /* ─── Masthead ─── */
    .masthead {
      background: var(--paper);
      border-top: 4px solid var(--ink);
      border-bottom: 1px solid var(--rule-thin);
      text-align: center;
      padding: 2rem 1rem 1.4rem;
      position: relative;
    }
    .masthead::after {
      content: '';
      display: block;
      height: 3px;
      background: linear-gradient(to right, transparent, var(--ink) 20%, var(--ink) 80%, transparent);
      margin-top: 1.4rem;
    }
    .masthead .flag-line {
      font-size: 1.4rem;
      letter-spacing: 0.4rem;
      margin-bottom: 0.5rem;
      color: var(--ink-faint);
    }
    .masthead h1 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(3rem, 8vw, 6.5rem);
      font-weight: 900;
      letter-spacing: -0.01em;
      line-height: 1;
      color: var(--ink);
      text-transform: uppercase;
    }
    .masthead .edition-bar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.2rem;
      margin-top: 0.7rem;
      font-family: 'Source Sans 3', Arial, sans-serif;
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }
    .masthead .edition-bar .dot { color: var(--rule-thin); }
    .masthead .tagline {
      font-family: 'Playfair Display', Georgia, serif;
      font-style: italic;
      font-size: 1rem;
      color: var(--gold);
      margin-top: 0.3rem;
    }

    /* ─── Section nav bar ─── */
    .section-nav {
      background: var(--ink);
      padding: 0 1rem;
      overflow-x: auto;
      white-space: nowrap;
    }
    .section-nav a {
      display: inline-block;
      color: #ccc;
      font-family: 'Source Sans 3', Arial, sans-serif;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.6rem 1rem;
      border-right: 1px solid #333;
      transition: color 0.15s, background 0.15s;
    }
    .section-nav a:first-child { border-left: 1px solid #333; }
    .section-nav a:hover { color: #fff; background: #333; }

    /* ─── Page wrapper ─── */
    .page { max-width: 1280px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }

    /* ─── Section block ─── */
    .section-block { margin-bottom: 3rem; }

    .section-header {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      border-top: 3px double var(--ink);
      padding-top: 0.5rem;
      margin-bottom: 1.4rem;
    }
    .section-header h2 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 1.5rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--ink);
    }
    .section-header .rule-line {
      flex: 1;
      height: 1px;
      background: var(--rule-thin);
      align-self: center;
    }
    .section-header .item-count {
      font-family: 'Source Sans 3', Arial, sans-serif;
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
      white-space: nowrap;
    }

    /* ─── Article grid ─── */
    .articles-grid {
      display: grid;
      gap: 0;
      grid-template-columns: repeat(4, 1fr);
    }

    /* Lead story (first card) gets 2 columns × full height */
    .articles-grid .article-card:first-child {
      grid-column: span 2;
      border-right: 1px solid var(--rule-thin);
    }

    /* ─── Article card ─── */
    .article-card {
      padding: 1.1rem 1.3rem 1rem;
      border-top: 1px solid var(--rule-thin);
      border-right: 1px solid var(--rule-thin);
      display: flex;
      flex-direction: column;
      position: relative;
    }
    /* remove right border on last in each row */
    .article-card:last-child { border-right: none; }

    /* Germany badge */
    .article-card.germany-priority::before {
      content: 'GERMANY';
      font-family: 'Source Sans 3', Arial, sans-serif;
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      color: #fff;
      background: var(--red-flag);
      padding: 0.15rem 0.45rem;
      display: inline-block;
      margin-bottom: 0.5rem;
      align-self: flex-start;
    }

    .article-card .source-label {
      font-family: 'Source Sans 3', Arial, sans-serif;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 0.35rem;
    }

    .article-card h3 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 1.05rem;
      font-weight: 700;
      line-height: 1.35;
      color: var(--ink);
      margin-bottom: 0.5rem;
    }
    /* Lead story title bigger */
    .articles-grid .article-card:first-child h3 {
      font-size: 1.55rem;
      line-height: 1.25;
    }

    .article-card .blurb {
      font-family: 'Source Serif 4', Georgia, serif;
      font-size: 0.88rem;
      font-weight: 300;
      color: var(--ink-soft);
      flex-grow: 1;
      margin-bottom: 0.8rem;
      display: -webkit-box;
      -webkit-line-clamp: 5;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .articles-grid .article-card:first-child .blurb {
      -webkit-line-clamp: 7;
      font-size: 0.95rem;
    }

    .article-card .card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid var(--rule-thin);
      padding-top: 0.5rem;
      margin-top: auto;
      gap: 0.5rem;
    }
    .article-card .pub-time {
      font-family: 'Source Sans 3', Arial, sans-serif;
      font-size: 0.68rem;
      color: var(--ink-faint);
      white-space: nowrap;
    }
    .article-card .read-more {
      font-family: 'Source Sans 3', Arial, sans-serif;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink);
      white-space: nowrap;
      border-bottom: 1px solid var(--gold);
      padding-bottom: 1px;
      transition: color 0.15s, border-color 0.15s;
    }
    .article-card .read-more:hover { color: var(--gold); }

    /* Hover lift */
    .article-card {
      transition: background 0.15s;
    }
    .article-card:hover { background: var(--paper-warm); }

    /* ─── No items ─── */
    .no-items {
      font-style: italic;
      color: var(--ink-faint);
      font-size: 0.9rem;
      padding: 1rem 0;
    }

    /* ─── Footer ─── */
    footer {
      border-top: 3px double var(--ink);
      padding: 2rem 1.5rem;
      max-width: 1280px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 1rem;
      align-items: start;
    }
    footer .footer-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 1.3rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 0.4rem;
    }
    footer p {
      font-family: 'Source Sans 3', Arial, sans-serif;
      font-size: 0.75rem;
      color: var(--ink-faint);
      line-height: 1.7;
    }
    footer .sources {
      text-align: right;
      font-family: 'Source Sans 3', Arial, sans-serif;
      font-size: 0.72rem;
      color: var(--ink-faint);
      line-height: 1.8;
    }

    /* ─── Responsive ─── */
    @media (max-width: 900px) {
      .articles-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .articles-grid .article-card:first-child {
        grid-column: span 2;
      }
    }
    @media (max-width: 560px) {
      .articles-grid {
        grid-template-columns: 1fr;
      }
      .articles-grid .article-card:first-child {
        grid-column: span 1;
      }
      .article-card { border-right: none; }
      .top-ribbon { justify-content: center; }
      .top-ribbon .hide-mobile { display: none; }
      footer { grid-template-columns: 1fr; }
      footer .sources { text-align: left; }
    }
  </style>
</head>
<body>

  <!-- Top ribbon -->
  <div class="top-ribbon">
    <span>{{ date }}</span>
    <span class="hide-mobile">English-language news from Germany</span>
    <span>{{ total_items }} stories &middot; {{ source_count }} sources</span>
  </div>

  <!-- Masthead -->
  <header class="masthead">
    <div class="flag-line">&#127465;&#127466;</div>
    <h1>Germany Daily</h1>
    <div class="tagline">German news in English &mdash; for immigrants &amp; expats</div>
    <div class="edition-bar">
      <span>Thursday Edition</span>
      <span class="dot">&bull;</span>
      <span>{{ date }}</span>
      <span class="dot">&bull;</span>
      <span>Vol. 1</span>
    </div>
  </header>

  <!-- Section nav -->
  <nav class="section-nav">
    {% for section_name in sections.keys() %}
    <a href="#section-{{ loop.index }}">{{ section_name }}</a>
    {% endfor %}
  </nav>

  <!-- Main content -->
  <main class="page">
    {% for section_name, items in sections.items() %}
    <section class="section-block" id="section-{{ loop.index }}">
      <div class="section-header">
        <h2>{{ section_name }}</h2>
        <div class="rule-line"></div>
        <span class="item-count">{{ items | length }} article{{ 's' if items | length != 1 else '' }}</span>
      </div>

      {% if items %}
      <div class="articles-grid">
        {% for item in items %}
        <article class="article-card{% if item.germany_priority %} germany-priority{% endif %}">
          <div class="source-label">{{ item.source_name }}</div>
          <h3>{{ item.title }}</h3>
          {% if item.description %}
          <p class="blurb">{{ item.description }}</p>
          {% endif %}
          <div class="card-footer">
            <span class="pub-time">{{ item.pub_date.strftime('%b %d, %H:%M') }}</span>
            <a class="read-more" href="{{ item.link }}" target="_blank" rel="noopener">Read &rarr;</a>
          </div>
        </article>
        {% endfor %}
      </div>
      {% else %}
      <p class="no-items">No articles in this section today.</p>
      {% endif %}
    </section>
    {% endfor %}
  </main>

  <!-- Footer -->
  <footer>
    <div>
      <div class="footer-title">Germany Daily</div>
      <p>
        Content sourced exclusively from RSS feed metadata. All original articles remain the property of their respective publishers.<br />
        RSS syndication is an open standard; aggregation is its intended purpose. No article body content was fetched or reproduced.<br />
        Links open the original article on the publisher&rsquo;s website.
      </p>
    </div>
    <div class="sources">
      <strong>Sources</strong><br />
      Deutsche Welle<br />
      The Local Germany<br />
      The Guardian<br />
      BBC Europe
    </div>
  </footer>

</body>
</html>
